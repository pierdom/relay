# Required — generate with: openssl rand -hex 32
API_KEY=change-me

# Optional — all have defaults
DEFAULT_TTL_HOURS=0  # 0 = never expire; set to e.g. 72 to enable global expiry
CLEANUP_INTERVAL_MINUTES=60
RELAY_VAULT_PATH=/data/vault   # vault path *inside* the container; index at <vault>/.relay/
RELAY_WATCH_ENABLED=true       # live-reindex + SSE on external edits (set false when relay is the only writer)
ATTACHMENT_MAX_MB=25           # reject attachment uploads larger than this (base64-decoded)

# Web UI login via OIDC (PocketID) — optional. Leave OIDC_ISSUER blank to disable
# and keep the API-key paste login. Register a client in PocketID with redirect URI
# <RELAY_BASE_URL>/auth/callback.
# OIDC_ISSUER=https://id.example.com          # PocketID base URL
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# SESSION_SECRET=                             # openssl rand -hex 32; falls back to API_KEY if unset
# SESSION_MAX_AGE_HOURS=720                   # signed session-cookie lifetime (default 30 days)
# Allowlist who may log in. Prefer OIDC_ALLOWED_SUBS (immutable IdP user id — can't
# be spoofed by editing a profile). OIDC_ALLOWED_EMAILS only matches *verified*
# emails. Both empty = any user PocketID authenticates is allowed.
# OIDC_ALLOWED_SUBS=pocketid-user-id-1,pocketid-user-id-2
# OIDC_ALLOWED_EMAILS=you@example.com

# Remote MCP OAuth (Phase 2 scaffold — advertises discovery metadata only for now).
# MCP_OAUTH_ENABLED=false
# MCP_REQUIRED_SCOPES=

# Docker only — host path bind-mounted to /data/vault (see docker-compose.yml).
# In production set an absolute host path; defaults to ./vault for local dev.
# RELAY_VAULT_DIR=/absolute/path/to/vault
# RELAY_UID=1000
# RELAY_GID=1000
