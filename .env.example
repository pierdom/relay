# Required — generate with: openssl rand -hex 32
API_KEY=change-me

# Optional — all have defaults
DEFAULT_TTL_HOURS=0  # 0 = never expire; set to e.g. 72 to enable global expiry
CLEANUP_INTERVAL_MINUTES=60
RELAY_VAULT_PATH=/data/vault   # vault path *inside* the container; index at <vault>/.relay/
RELAY_WATCH_ENABLED=true       # live-reindex + SSE on external edits (set false when relay is the only writer)

# Docker only — host path bind-mounted to /data/vault (see docker-compose.yml).
# In production set an absolute host path; defaults to ./vault for local dev.
# RELAY_VAULT_DIR=/absolute/path/to/vault
# RELAY_UID=1000
# RELAY_GID=1000
