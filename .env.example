# Required — generate with: openssl rand -hex 32
API_KEY=change-me

# Optional — all have defaults
DEFAULT_TTL_HOURS=0  # 0 = never expire; set to e.g. 72 to enable global expiry
CLEANUP_INTERVAL_MINUTES=60
RELAY_VAULT_PATH=/data/vault   # vault path *inside* the container; index at <vault>/.relay/
RELAY_WATCH_ENABLED=true       # live-reindex + SSE on external edits (set false when relay is the only writer)
RELAY_HISTORY_ENABLED=true     # git commit per write into <vault>/.relay/history.git (needs the git binary; no-ops without it)
ATTACHMENT_MAX_MB=25           # reject attachment uploads larger than this (all transports)
ATTACHMENT_UPLOAD_TTL_SECONDS=3600      # presigned upload slot lifetime before purge
ATTACHMENT_FETCH_TIMEOUT_SECONDS=20     # timeout for a server-side source_url fetch

# Semantic/hybrid search (relay #253, proof of concept) — off by default
# everywhere. Downloads an embedding model on first use into <vault>/.relay/
# (models/ + hf-home/, so it survives restarts and rides the vault volume in
# Docker) and keeps it resident in memory for the process lifetime. Memory
# footprint under a small VPS is still being characterized — see the relay
# post tracking this if you hit it. Enabling exposes mode=semantic|hybrid on
# GET /posts and list_posts; check features.search.embeddings in /status to
# confirm it actually came up.
# RELAY_EMBEDDING_ENABLED=false
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Web UI login via OIDC (PocketID) — optional. Leave OIDC_ISSUER blank to disable
# and keep the API-key paste login. Register a client in PocketID with redirect URI
# <RELAY_BASE_URL>/auth/callback.
# OIDC_ISSUER=https://id.example.com          # PocketID base URL
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# SESSION_SECRET=                             # openssl rand -hex 32; falls back to API_KEY if unset
# SESSION_MAX_AGE_HOURS=720                   # signed session-cookie lifetime (default 30 days)
# Allowlist who may log in. Prefer OIDC_ALLOWED_SUBS (immutable IdP user id — can't
# be spoofed by editing a profile). OIDC_ALLOWED_EMAILS only matches *verified*
# emails. Both empty = any user PocketID authenticates is allowed.
# OIDC_ALLOWED_SUBS=pocketid-user-id-1,pocketid-user-id-2
# OIDC_ALLOWED_EMAILS=you@example.com

# Remote MCP OAuth — relay acts as its own OAuth 2.1 Authorization Server so
# Claude Desktop / claude.ai can connect to /mcp directly (dropping the local
# stdio proxy). Requires the OIDC_* config above: the human login is brokered
# upstream to PocketID, reusing that same client. Before enabling, add the
# callback redirect URI  <RELAY_BASE_URL>/mcp/oauth/callback  to that PocketID
# client's allowed list. The static API_KEY still works as a bearer when on.
# MCP_OAUTH_ENABLED=false
# MCP_REQUIRED_SCOPES=relay                    # single scope = full tool access
# DCR redirect-URI host allowlist (https). Blocks a rogue client from registering
# an auth-code callback to its own host. Exact host match; blank = any https
# (opt-out). Loopback (native/IDE) clients use http://localhost and need no entry.
# MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com
#   Add hosts for other clients you use:
#   ChatGPT:    chatgpt.com,chat.openai.com
#   Perplexity: www.perplexity.ai   (enterprise.perplexity.ai on Enterprise)
#   Mistral:    console.mistral.ai   (Le Chat host: verify from the connector UI)
# Token lifetimes (seconds); defaults shown.
# MCP_AUTH_CODE_TTL_SECONDS=60
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# Docker only — host path bind-mounted to /data/vault (see docker-compose.yml).
# In production set an absolute host path; defaults to ./vault for local dev.
# RELAY_VAULT_DIR=/absolute/path/to/vault
# RELAY_UID=1000
# RELAY_GID=1000
