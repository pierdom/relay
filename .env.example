# Required — generate with: openssl rand -hex 32
API_KEY=change-me

# Optional — all have defaults
DEFAULT_TTL_HOURS=0  # 0 = never expire; set to e.g. 72 to enable global expiry
CLEANUP_INTERVAL_MINUTES=60
RELAY_VAULT_PATH=/data/vault   # Obsidian-style Markdown vault; index lives in <vault>/.relay/
RELAY_WATCH_ENABLED=true       # live-reindex + SSE on external edits (set false to disable)
